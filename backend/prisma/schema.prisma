// ==========================================================================
// Schéma Prisma — Architecture Multi-Tenant
// Un serveur unique, plusieurs entreprises clientes (Tenants) isolées par
// leur numéro WhatsApp dédié (whatsappPhoneNumber = clé pivot du routage).
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// ÉNUMÉRATIONS (Règles strictes pour éviter les erreurs de saisie)
// --------------------------------------------------------------------------
enum SubscriptionBadge {
  essentiel // 99€ / mois
  premium   // 149€ / mois — débloque trajet/agenda/GPS proactif
}

enum OnboardingStatus {
  pending_onboarding // numéro provisionné après paiement, en attente du 1er message
  in_progress        // questionnaire d'accueil en cours
  completed          // configuration terminée, bot opérationnel
}

// NOUVEAU : Préférences d'appel de l'artisan (Question 6)
enum CallPreference {
  FIRST_CONTACT      // Dès le premier message d'un client
  NEW_BOOKING_ONLY   // Seulement lors d'une réservation/demande d'intervention validée
  URGENCY_ONLY       // Uniquement en cas d'urgence absolue
  WHATSAPP_ONLY      // Jamais d'appel, uniquement des messages texte
}

// NOUVEAU : Politique tarifaire annoncée par l'IA (Question 8)
enum PricingPolicy {
  NO_PRICE_GIVEN       // Ne donne aucun prix, renvoie vers un devis
  SHOW_STARTING_PRICE  // Donne un prix "à partir de..." indicatif
  FREE_QUOTE_ON_SITE   // Précise que le devis et le déplacement sont gratuits
}

// NOUVEAU : Ton de voix du Bot (Question 9)
enum BotTone {
  VOUVOIEMENT
  TUTOIEMENT
}

// --------------------------------------------------------------------------
// TENANT (Artisan / Entreprise cliente)
// --------------------------------------------------------------------------
model Tenant {
  id                     String             @id @default(uuid())

  // Identité & routage multi-tenant
  whatsappPhoneNumber    String             @unique // ex: "whatsapp:+33612345678"
  customerEmail          String             @unique // identifiant Stripe
  
  // --- RÉPONSES ONBOARDING ---
  companyName            String?            // Q1 : Nom entreprise
  activityType           String?            // Q2 : Plombier, Électricien...
  geographicZone         String?            // Q3 : Zone d'intervention
  baseAddress            String?            // Q4 : Siège/Dépôt (Nouveau)
  workingHours           String?            // Q5 : Horaires de travail (Nouveau)
  callPreference         CallPreference     @default(NEW_BOOKING_ONLY) // Q6 : Règles d'appels
  emergencyTypes         String?            @db.Text // Q7 : Définition des urgences (Nouveau)
  pricingPolicy          PricingPolicy      @default(NO_PRICE_GIVEN)   // Q8 : Règles de prix (Nouveau)
  botTone                BotTone            @default(VOUVOIEMENT)      // Q9 : Vouvoiement/Tutoiement (Nouveau)
  locationTrackingActive Boolean            @default(false)            // Q10 : Suivi GPS
  customInstructions     String?            @db.Text // Q11 : Consignes libres (Nouveau)

  // Abonnement / Paiement
  subscriptionBadge      SubscriptionBadge  @default(essentiel)
  countryCode            String?            // ex: "FR"
  onboardingStatus       OnboardingStatus   @default(pending_onboarding)

  // Intégrations tierces (Google API)
  googleBusinessToken    String? 
  googleBusinessRefresh  String? 
  googleBusinessLocationId String? 

  // Position GPS courante (badge premium)
  lastKnownLat           Float?
  lastKnownLng           Float?
  lastLocationUpdateAt   DateTime?

  // État de conversation (machine à états pour l'onboarding)
  conversationState      String?  @db.Text 

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  appointments           Appointment[]
  reviews                Review[]

  @@index([customerEmail])
  @@index([onboardingStatus])
}

// --------------------------------------------------------------------------
// APPOINTMENT (Chantiers / RDV — trajets, ponctualité, badge premium)
// --------------------------------------------------------------------------
enum AppointmentStatus {
  scheduled
  en_route
  on_site
  completed
  delayed
  cancelled
}

model Appointment {
  id                   String            @id @default(uuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientName           String
  clientPhoneNumber    String?
  address              String
  latitude             Float?
  longitude            Float?

  scheduledAt          DateTime
  estimatedDurationMin Int?
  estimatedTravelMin   Int? 

  status               AppointmentStatus @default(scheduled)
  delayNotifiedAt      DateTime?
  recalculatedEta      DateTime?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  reviews              Review[]

  @@index([tenantId, scheduledAt])
  @@index([status])
}

// --------------------------------------------------------------------------
// REVIEW (Avis clients Google — chasseur d'avis automatisé)
// --------------------------------------------------------------------------
enum ReviewStatus {
  awaiting_customer   
  received            
  pending_validation  
  published           
  rejected            
}

model Review {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointmentId    String?
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id])

  googleReviewId   String?       @unique
  reviewerName     String?
  rating           Int?
  reviewText       String?       @db.Text
  aiDraftReply     String?       @db.Text

  status           ReviewStatus  @default(awaiting_customer)
  reviewLinkSentAt DateTime?
  publishedAt      DateTime?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId, status])
}