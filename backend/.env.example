# ==========================================================================
# FICHIER D'EXEMPLE — copier en ".env" et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel (voir .gitignore).
# ==========================================================================

# --- Serveur ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=https://votre-domaine-ou-ngrok.ngrok-free.app

# --- Base de données (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/artisan_saas?schema=public"

# --- Sécurité applicative ---
# Clé secrète utilisée pour signer les tokens internes (JWT admin / backoffice)
JWT_SECRET=change_me_super_secret_random_string
# Clé utilisée pour chiffrer les tokens OAuth Google stockés en base (AES-256-GCM, 32 octets en hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Twilio (WhatsApp Business + Voice) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Fallback si aucun numéro dédié n'est encore provisionné pour un tenant
TWILIO_VOICE_FROM=+14155551234

# --- Meta / WhatsApp Cloud API (alternative directe à Twilio, si utilisée) ---
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_VERIFY_TOKEN=un_token_de_verification_choisi_par_vous
META_WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google (Business Profile + Maps/Directions) ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://votre-domaine.com/oauth/google/callback
GOOGLE_MAPS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe (paiement / abonnements) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Notifications internes admin (en cas d'échec critique de provisioning) ---
ADMIN_ALERT_EMAIL=admin@votre-entreprise.com
